{
  "packageManager": "yarn@4.11.0",
  "name": "@quonfig/react",
  "version": "1.2.0",
  "description": "Feature Flags & Dynamic Configuration as a Service",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/quonfig/sdk-react.git"
  },
  "bugs": {
    "url": "https://github.com/quonfig/sdk-react/issues"
  },
  "homepage": "https://github.com/quonfig/sdk-react#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-version.mjs",
    "build": "rm -rf dist/ && tsup",
    "dev": "tsup --watch",
    "bundle": "esbuild --minify --target=esnext --bundle --outfile=dist/quonfig-react.bundle.js --global-name=window.quonfigReactNamespace dist/index.cjs && echo 'window.quonfigReact = window.quonfigReactNamespace.quonfigReact' >> dist/quonfig-react.bundle.js",
    "test": "tsup && jest --verbose",
    "lint": "eslint src/",
    "prettier": "prettier . -l",
    "prettier:fix": "prettier --write .",
    "version": "prettier --write CHANGELOG.md README.md && git add CHANGELOG.md README.md"
  },
  "size-limit": [
    {
      "name": "dist/index.mjs (gzipped)",
      "path": "dist/index.mjs",
      "limit": "2 kB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "@quonfig/javascript"
      ]
    }
  ],
  "author": "Jeffrey Chupp",
  "license": "ISC",
  "keywords": [
    "feature-flags",
    "config"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quonfig/javascript": "^1.2.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.6.5",
    "@types/react": "^19.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^3.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "size-limit": "^13.0.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "tsup": "^8.4.0",
    "typescript": "~4.9.5",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "@quonfig/javascript": "^1.2.0",
    "react": "^18 || ^19"
  }
}
